{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/short-drama-writer/reveal-arc.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "arc_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "known_truth",
        "partial_truth",
        "mystery"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "resolved"
      ]
    },
    "start_episode": {
      "type": "integer",
      "minimum": 1
    },
    "due_episode": {
      "type": "integer",
      "minimum": 1
    },
    "setback_budget": {
      "type": "integer",
      "minimum": 0
    },
    "core_truth": {
      "type": "string",
      "minLength": 1
    },
    "audience_anchor": {
      "type": "object",
      "properties": {
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "visible_evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scene_id",
        "visible_evidence"
      ],
      "additionalProperties": false
    },
    "protagonist_goal": {
      "type": "string",
      "minLength": 1
    },
    "why_not_reveal_immediately": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "protagonist",
              "opponent",
              "crowd",
              "ally",
              "authority"
            ]
          },
          "initial_belief": {
            "type": "string",
            "minLength": 1
          },
          "initial_stance": {
            "type": "string",
            "minLength": 1
          },
          "incentive": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "role",
          "initial_belief",
          "initial_stance",
          "incentive"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "introduced_at_beat": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "introduced_at_beat"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "episode_number": {
            "type": "integer",
            "minimum": 1
          },
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "anchor",
              "provocation",
              "signal",
              "countermove",
              "payoff",
              "consequence"
            ]
          },
          "disputed_question": {
            "type": "string",
            "minLength": 1
          },
          "audience_expectation": {
            "type": "string",
            "minLength": 1
          },
          "new_information": {
            "type": "string"
          },
          "evidence_fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "protagonist_action": {
            "type": "string",
            "minLength": 1
          },
          "belief_updates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "actor_id": {
                  "type": "string",
                  "minLength": 1
                },
                "before": {
                  "type": "string",
                  "minLength": 1
                },
                "after": {
                  "type": "string",
                  "minLength": 1
                },
                "basis_fact_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "actor_id",
                "before",
                "after",
                "basis_fact_ids"
              ],
              "additionalProperties": false
            }
          },
          "public_moves": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "actor_id": {
                  "type": "string",
                  "minLength": 1
                },
                "before": {
                  "type": "string",
                  "minLength": 1
                },
                "after": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "basis_fact_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "actor_id",
                "before",
                "after",
                "reason",
                "basis_fact_ids"
              ],
              "additionalProperties": false
            }
          },
          "earned_payoffs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "visible_evidence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "description",
                "visible_evidence"
              ],
              "additionalProperties": false
            }
          },
          "carry_forward_payoff_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "setback_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "episode_number",
          "scene_id",
          "kind",
          "disputed_question",
          "audience_expectation",
          "new_information",
          "evidence_fact_ids",
          "protagonist_action",
          "belief_updates",
          "public_moves",
          "earned_payoffs",
          "carry_forward_payoff_ids",
          "setback_reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "final_cashout": {
      "type": "object",
      "properties": {
        "episode_number": {
          "type": "integer",
          "minimum": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "actual_change": {
          "type": "string",
          "minLength": 1
        },
        "old_question_closed": {
          "type": "boolean"
        }
      },
      "required": [
        "episode_number",
        "scene_id",
        "evidence_fact_ids",
        "actual_change",
        "old_question_closed"
      ],
      "additionalProperties": false
    },
    "next_conflict": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "arc_id",
    "title",
    "mode",
    "status",
    "start_episode",
    "due_episode",
    "setback_budget",
    "core_truth",
    "audience_anchor",
    "protagonist_goal",
    "why_not_reveal_immediately",
    "actors",
    "facts",
    "beats",
    "final_cashout",
    "next_conflict"
  ],
  "additionalProperties": false
}
