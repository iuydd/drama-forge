{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story bible",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "canon_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "emotional_promise": {
      "type": "string",
      "minLength": 1
    },
    "story_engine": {
      "type": "string",
      "minLength": 1
    },
    "ending_direction": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "details"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "details"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "details"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_plan": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "evidence_plan"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "initial_fact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "locked_canon": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "world_feedback": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "canon_version",
    "status",
    "emotional_promise",
    "story_engine",
    "ending_direction",
    "characters",
    "locations",
    "props",
    "rules",
    "initial_fact_ids",
    "locked_canon",
    "world_feedback"
  ],
  "additionalProperties": false
}
