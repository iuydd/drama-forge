{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review report (templates may be incomplete; gate is stricter)",
  "type": "object",
  "required": [
    "schema_version",
    "shot_id",
    "contract_sha256",
    "stage",
    "artifact",
    "reviewer",
    "coverage",
    "checks",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "enum": [
        "image",
        "video",
        "view_asset"
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "vision_model",
            "human"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "kind",
        "basis"
      ],
      "properties": {
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "basis": {
          "enum": [
            "not_reviewed",
            "full_image",
            "sampled",
            "full_frames",
            "risk_based"
          ]
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result",
          "observation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "resolved",
          "description"
        ],
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "resolved": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
