{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_mode",
    "project_id",
    "request_id",
    "plan_id",
    "revision",
    "episode_ids",
    "status",
    "part_index",
    "manifest",
    "records",
    "assumptions",
    "execution_blockers",
    "invalidates"
  ],
  "properties": {
    "schema_version": {
      "const": "brain-preproduction-response-1"
    },
    "workflow_mode": {
      "const": "upfront_only"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "episode_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "PARTIAL",
        "COMPLETE",
        "BLOCKED"
      ]
    },
    "part_index": {
      "type": "integer",
      "minimum": 1
    },
    "manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "episode_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "world",
              "episode",
              "asset",
              "task",
              "repair",
              "delivery"
            ]
          },
          "episode_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 2,
            "description": "完整JSON对象序列化为字符串，本地再次严格解析。"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "前期大脑分块响应，不含媒体批准"
}
